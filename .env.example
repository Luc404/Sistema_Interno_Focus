# Aplicação
APP_NAME=Sistema Focus API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false

# Banco de dados
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sistema_focus_db

# Segurança
SECRET_KEY=troque-por-uma-chave-aleatoria-com-no-minimo-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (separar por vírgula)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=25

# Em produção, desative a criação automática e use Alembic
AUTO_CREATE_TABLES=true

# Administrador inicial (opcional, criado apenas se o banco estiver vazio)
FIRST_ADMIN_EMAIL=admin@focus.local
FIRST_ADMIN_PASSWORD=Admin123
FIRST_ADMIN_NOME=Administrador
